% =========================================================================
% Taller 1: Identificación Gráfica de Sistemas FOTD
% Código simplificado usando lógica básica de programación
% =========================================================================

clear; clc; close all;

datos = readtable('datos_motor.csv');
t = datos{:, 1};
u = datos{:, 2};
y = datos{:, 3};

%% 2. ENCONTRAR EL INICIO DEL ESCALÓN
for k = 1:length(u)
    if u(k) > u(1) 
        indice_escalon = k;
        break;
    end
end
t_escalon = t(indice_escalon);

%% 3. CÁLCULO DE VALORES INICIALES, FINALES Y GANANCIA (K)
u_inicial = u(1);
u_final = u(end);
y_inicial = y(1);
y_final = y(end);

delta_u = u_final - u_inicial;
delta_y = y_final - y_inicial;

K = delta_y / delta_u; % Ganancia estática del sistema

%% 4. BUSCAR TIEMPOS A LOS PORCENTAJES  (28.3% y 63.2%)
nivel_283 = y_inicial + 0.283 * delta_y;
nivel_632 = y_inicial + 0.632 * delta_y;

t_283 = 0;
for k = indice_escalon:length(y)
    if y(k) >= nivel_283
        t_283 = t(k);
        break;
    end
end

% Buscar en qué momento la señal cruza el 63.2%
t_632 = 0;
for k = indice_escalon:length(y)
    if y(k) >= nivel_632
        t_632 = t(k);
        break;
    end
end

%% 5. MÉTODO ZIEGLER-NICHOLS (Recta Tangente)
dy = diff(y);
dt = diff(t);
pendiente = dy ./ dt;

% Encontramos cuál es la pendiente más inclinada (velocidad máxima de subida)
[m_max, idx_max] = max(pendiente);
t_max = t(idx_max);
y_max = y(idx_max);

% Ecuación de la recta: y
t_cruce_abajo = (y_inicial - y_max) / m_max + t_max;
t_cruce_arriba = (y_final - y_max) / m_max + t_max;

theta_zc = t_cruce_abajo - t_escalon;
tau_zc = t_cruce_arriba - t_cruce_abajo;

%% 6. MÉTODO DE MILLER (63.2%)
theta_miller = theta_zc; % aprobechando el retardo encontrado Ziegler-Nichols
tau_miller = (t_632 - t_escalon) - theta_miller;

%% 7. MÉTODO ANALÍTICO (Doble Punto)
tau_analitico = 1.5 * (t_632 - t_283);
theta_analitico = (t_632 - t_escalon) - tau_analitico;

%% 8. GRAFICOS DE LOS MODELOS
G_zc = tf(K, [tau_zc 1], 'InputDelay', theta_zc);
G_miller = tf(K, [tau_miller 1], 'InputDelay', theta_miller);
G_analitico = tf(K, [tau_analitico 1], 'InputDelay', theta_analitico);

y_zc = lsim(G_zc, u, t);
y_miller = lsim(G_miller, u, t);
y_analitico = lsim(G_analitico, u, t);

%% 9. MOSTRAR RESULTADOS
fprintf('\n--- PARÁMETROS OBTENIDOS ---\n');
fprintf('Ganancia K = %.4f\n\n', K);
fprintf('1. Ziegler-Nichols : tau = %.4f s, theta = %.4f s\n', tau_zc, theta_zc);
fprintf('2. Miller (63.2%%)  : tau = %.4f s, theta = %.4f s\n', tau_miller, theta_miller);
fprintf('3. Analítico       : tau = %.4f s, theta = %.4f s\n\n', tau_analitico, theta_analitico);

%% 10. GRÁFICA PARA COAMPARAR LOS METODOS
figure('Name', 'Comparacion Metodos');
plot(t, y, 'k', 'LineWidth', 1.5); hold on;
plot(t, y_zc, 'b--', 'LineWidth', 1.5);
plot(t, y_miller, 'r--', 'LineWidth', 1.5);
plot(t, y_analitico, 'g--', 'LineWidth', 1.5);

% Trazar líneas horizontales para valor inicial y final
yline(y_inicial, 'k:');
yline(y_final, 'k:');

xlabel('Tiempo [s]');
ylabel('Amplitud');
title('Respuesta del sistema según cada método');
legend('Datos Medidos', 'Ziegler-Nichols', 'Miller', 'Analítico', 'Location', 'southeast');
grid on;